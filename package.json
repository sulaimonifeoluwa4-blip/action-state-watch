{
  "name": "action-state-watch",
  "version": "0.1.0",
  "private": true,
  "description": "Scheduled TTL/archival health monitor for deployed Soroban contracts",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts --source-map --license licenses.txt",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ __tests__/ --ext .ts",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "package": "npm run build"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0",
    "@octokit/rest": "^21.1.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.17.57",
    "@vercel/ncc": "^0.38.3",
    "eslint": "^9.27.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.4",
    "typescript": "^5.8.3"
  }
}
